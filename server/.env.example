# Server Port (Render sets this automatically)
PORT=4000
NODE_ENV=production

# Security: JWT Secret (at least 32 characters)
JWT_SECRET=your_long_random_jwt_secret_at_least_32_characters_here

# MongoDB Connection String (from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password

# Allowed Client Origins (Vercel deployment domain, comma-separated for multiple)
CLIENT_ORIGIN=https://uniquewellnessinstitute.vercel.app,https://uniquewellnessinstitute-three.vercel.app
ALLOW_VERCEL_PREVIEWS=true
